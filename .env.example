# ─── Mode ───────────────────────────────────────────────
# selfhosted  → Login mit globalem Passwort (Standard)
# saas        → Kein Login, Rooms per Link
MODE=selfhosted

# ─── Selfhosted ──────────────────────────────────────────
PASSWORD=dein-passwort
JWT_SECRET=langer-zufaelliger-string-hier-einsetzen

# ─── Optional ────────────────────────────────────────────
# PORT=3000

# Admin-Übersicht unter /#/admin — zeigt alle Gruppen (Name, Teilnehmer,
# Ausgaben, Ablaufdatum) unabhängig von MODE. Ohne gesetztes Passwort ist
# die Route deaktiviert (503).
# ADMIN_PASSWORD=anderes-passwort-als-oben

# Nur nötig wenn das Frontend NICHT vom selben Backend ausgeliefert wird
# (Standardfall same-origin braucht das nicht). Komma-getrennte Liste.
# ALLOWED_ORIGINS=https://divide-it.app
